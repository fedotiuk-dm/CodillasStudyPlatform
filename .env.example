# Copy to docker/.env (docker stack) and/or export for the backend. Dev defaults below.

# --- Postgres (app DB; Keycloak gets a 'keycloak' DB in the same instance) ---
POSTGRES_USER=codillas
POSTGRES_PASSWORD=codillas
POSTGRES_DB=codillas

# --- Keycloak admin console (http://localhost:8080) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- minio (S3 for the files module) ---
MINIO_ROOT_USER=codillas
MINIO_ROOT_PASSWORD=codillas123
MINIO_BUCKET=codillas

# --- Backend when run on the host (matches the docker services above) ---
DB_URL=jdbc:postgresql://localhost:5432/codillas
DB_USER=codillas
DB_PASSWORD=codillas
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/codillas
SERVER_PORT=8081
