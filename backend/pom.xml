<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>de.codillas</groupId>
  <artifactId>codillas-study-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Codillas Study Platform</name>
  <description>Learning platform for the Codillas IT school (Spring Modulith)</description>

  <modules>
    <module>shared</module>
    <module>user</module>
    <module>course</module>
    <module>enrollment</module>
    <module>homework</module>
    <module>assessment</module>
    <module>gradebook</module>
    <module>chat</module>
    <module>notification</module>
    <module>files</module>
    <module>main</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <!-- Versions not managed by the Spring Boot BOM -->
    <spring-modulith.version>2.1.0</spring-modulith.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc.version>3.0.3</springdoc.version>
    <keycloak.version>26.0.9</keycloak.version>
    <openapi-generator.version>7.23.0</openapi-generator.version>
    <spotless.version>3.7.0</spotless.version>
    <google-java-format.version>1.35.0</google-java-format.version>
    <mockito-maven-plugin.version>1.0.0</mockito-maven-plugin.version>
    <!-- API-first generation: a module with a spec overrides these four; others inherit skip=true. -->
    <openapi.skip>true</openapi.skip>
    <openapi.spec/>
    <openapi.api-package/>
    <openapi.model-package/>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- ponytail: common deps live in the parent so module poms stay near-empty.
       Split per-module if build weight ever matters. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <!-- @PreAuthorize at module API boundaries; full filter chain only assembles in main. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- jspecify @Nullable: Boot manages the version but it is NOT on the compile classpath
         transitively (spring-core declares it optional). Generated DTOs import it, so it must be
         declared explicitly — same as boosting/backend/pom.xml. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Boot 4 modularized autoconfig: LiquibaseAutoConfiguration lives here, NOT in
         spring-boot-autoconfigure, and liquibase-core does not pull it in transitively.
         This brings liquibase-core + the autoconfiguration. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-liquibase</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
        <!-- API-first: each module adds an <execution> with its inputSpec + packages. -->
        <plugin>
          <groupId>org.openapitools</groupId>
          <artifactId>openapi-generator-maven-plugin</artifactId>
          <version>${openapi-generator.version}</version>
          <configuration>
            <generatorName>spring</generatorName>
            <enablePostProcessFile>true</enablePostProcessFile>
            <generateModelDocumentation>false</generateModelDocumentation>
            <configOptions>
              <documentationProvider>source</documentationProvider>
              <interfaceOnly>true</interfaceOnly>
              <useTags>true</useTags>
              <useSpringBoot4>true</useSpringBoot4>
              <useJackson3>true</useJackson3>
              <openApiNullable>false</openApiNullable>
              <useEnumCaseInsensitive>false</useEnumCaseInsensitive>
              <containerDefaultToNull>false</containerDefaultToNull>
              <hideGenerationTimestamp>true</hideGenerationTimestamp>
              <useSwaggerUI>false</useSwaggerUI>
              <skipDefaultInterface>true</skipDefaultInterface>
            </configOptions>
            <generateAliasAsModel>true</generateAliasAsModel>
            <typeMappings>
              <typeMapping>OffsetDateTime=Instant</typeMapping>
              <typeMapping>LocalDateTime=Instant</typeMapping>
            </typeMappings>
            <importMappings>
              <importMapping>Instant=java.time.Instant</importMapping>
              <importMapping>OffsetDateTime=java.time.Instant</importMapping>
              <importMapping>LocalDateTime=java.time.Instant</importMapping>
              <importMapping>Pageable=org.springframework.data.domain.Pageable</importMapping>
              <importMapping>Nullable=org.jspecify.annotations.Nullable</importMapping>
            </importMappings>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <!-- Order matters: lombok, then the binding, then mapstruct. -->
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok-mapstruct-binding</artifactId>
              <version>0.2.0</version>
            </path>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
            <!-- Hibernate static metamodel (Entity_): type-safe field names for Sort/queries. -->
            <path>
              <groupId>org.hibernate.orm</groupId>
              <artifactId>hibernate-processor</artifactId>
              <version>${hibernate.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <importOrder>
              <order>java,javax,jakarta,org.springframework,org.springframework.*,de.codillas,lombok</order>
            </importOrder>
            <removeUnusedImports/>
          </java>
        </configuration>
      </plugin>
      <!-- Mockito agent (Java 21+ needs explicit attachment). The prepareAgent goal sets argLine;
           surefire propagates it via @{argLine}. Same setup as the aksi / coffeetamine projects. -->
      <plugin>
        <groupId>dev.jeschke.maven.mockito</groupId>
        <artifactId>mockito-maven-plugin</artifactId>
        <version>${mockito-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepareAgent</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- @{argLine} = the Mockito agent set by prepareAgent. The JVM's benign "CDS sharing
               limited" note comes from the agent appending to the bootstrap classpath — we leave it
               rather than disable CDS to hide it (same as the aksi / coffeetamine projects). -->
          <argLine>@{argLine}</argLine>
        </configuration>
      </plugin>
      <!-- API-first generation, configured once. A module opts in via the openapi.* properties;
           modules without a spec inherit openapi.skip=true and generate nothing. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-api</id>
            <goals><goal>generate</goal></goals>
            <phase>generate-sources</phase>
            <configuration>
              <skip>${openapi.skip}</skip>
              <inputSpec>${maven.multiModuleProjectDirectory}/openapi/${openapi.spec}</inputSpec>
              <apiPackage>${openapi.api-package}</apiPackage>
              <modelPackage>${openapi.model-package}</modelPackage>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-generated-source</id>
            <goals><goal>add-source</goal></goals>
            <phase>generate-sources</phase>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/openapi/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
